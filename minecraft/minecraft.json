{
  "type": "minecraft-java",
  "display": "Minecraft: Java Edition",
  "icon": "minecraft-java",
  "data": {
    "eula": {
      "type": "boolean",
      "value": false,
      "display": "EULA Agreement (true/false)",
      "desc": "Do you (or the server owner) agree to the <a href='https://account.mojang.com/documents/minecraft_eula'>Minecraft EULA?</a>",
      "required": true,
      "userEdit": true
    },
    "forgebuild": {
      "type": "string",
      "value": "",
      "display": "Forge Version",
      "desc": "Version of Forge to install (may be located <a href='http://files.minecraftforge.net/#Downloads'>here</a>",
      "required": false,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "javaversion": {
      "type": "string",
      "value": "21",
      "display": "Java Version",
      "desc": "Version of Java to use",
      "required": true,
      "userEdit": true
    },
    "jvmArgs": {
      "type": "string",
      "value": "",
      "display": "JVM Arguments",
      "desc": "Extra JVM arguments to pass",
      "required": false,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 2048,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate to the Java Heap",
      "required": true,
      "userEdit": false
    },
    "modlauncher": {
      "type": "string",
      "value": "",
      "display": "Mod/Plugin Launcher",
      "desc": "What mod or plugin launcher should be installed with Minecraft",
      "required": false,
      "userEdit": true,
      "options": [
        {
          "value": "",
          "display": "None/Vanilla"
        },
        {
          "value": "fabric",
          "display": "Fabric"
        },
        {
          "value": "forge",
          "display": "MinecraftForge"
        },
        {
          "value": "paper",
          "display": "Paper"
        },
        {
          "value": "spigot",
          "display": "Spigot"
        }
      ]
    },
    "motd": {
      "type": "string",
      "value": "A Minecraft Server\\n\\u00A79 hosted on PufferPanel",
      "display": "MOTD message of the day",
      "desc": "This is the message that is displayed in the server list of the client, below the name. The MOTD does support <a href='https://minecraft.gamepedia.com/Formatting_codes' target='_blank'>color and formatting codes</a>.",
      "required": true,
      "userEdit": true
    },
    "paperbuild": {
      "type": "string",
      "value": "203",
      "display": "build",
      "desc": "Build of Paper to install (<a href='https://papermc.io/downloads'>Paper version build</a>). Must be specified as a build number, e.g. 484",
      "required": false,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "What port to bind the server to",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "latest",
      "display": "Version",
      "desc": "Version of Minecraft you wish to install. It is best to put a version in, as latest may not work with all server software.",
      "required": true,
      "userEdit": true
    },
    "resolvedForgeVersion": {
      "type": "string",
      "value": "",
      "display": "Resolved Forge Version",
      "desc": "Internal, resolved version of Forge",
      "required": true,
      "userEdit": true,
      "internal": true
    }
  },
  "groups": [
    {
      "display": "General",
      "description": "General settings for all servers",
      "variables": [
        "eula",
        "memory",
        "ip",
        "port",
        "motd",
        "version",
        "javaversion",
        "modlauncher",
        "jvmArgs"
      ],
      "order": 1
    },
    {
      "if": "modlauncher == 'forge'",
      "display": "Forge",
      "description": "Settings if using MinecraftForge",
      "variables": [
        "forgebuild"
      ],
      "order": 2
    },
    {
      "if": "modlauncher == 'paper'",
      "display": "Paper",
      "description": "Settings specific if using Paper",
      "variables": [
        "paperbuild"
      ],
      "order": 3
    }
  ],
  "install": [
    {
      "if": "javaversion != '' && env == 'host'",
      "type": "javadl",
      "version": "${javaversion}"
    },
    {
      "if": "modlauncher == ''",
      "type": "mojangdl",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'fabric'",
      "type": "fabricdl"
    },
    {
      "if": "modlauncher == 'fabric' && env == 'host'",
      "type": "command",
      "commands": [
        "java${javaversion} -jar fabric-installer.jar server -mcversion ${version} -downloadMinecraft -noprofile -loader latest"
      ]
    },
    {
      "if": "modlauncher == 'fabric' && env != 'host'",
      "type": "command",
      "commands": [
        "java -jar fabric-installer.jar server -mcversion ${version} -downloadMinecraft -noprofile -loader latest"
      ]
    },
    {
      "if": "modlauncher == 'fabric'",
      "type": "mojangdl",
      "version": "${version}",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'forge'",
      "type": "forgedl",
      "target": "installer.jar",
      "version": "${forgebuild}",
      "minecraftVersion": "${version}",
      "outputVariable": "resolvedForgeVersion"
    },
    {
      "if": "modlauncher == 'forge' && env == 'host'",
      "type": "command",
      "commands": [
        "java${javaversion} -jar installer.jar --installServer"
      ]
    },
    {
      "if": "modlauncher == 'forge' && env != 'host'",
      "type": "command",
      "commands": [
        "java -jar installer.jar --installServer"
      ]
    },
    {
      "if": "modlauncher == 'forge' && file_exists('forge-' + resolvedForgeVersion + '-shim.jar')",
      "type": "move",
      "source": "forge-${resolvedForgeVersion}-shim.jar",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'forge' && file_exists('forge-' + resolvedForgeVersion + '.jar')",
      "type": "move",
      "source": "forge-${resolvedForgeVersion}.jar",
      "target": "server.jar"
    },
    {
      "if": "modlauncher == 'paper'",
      "type": "download",
      "files": [
        "https://api.papermc.io/v2/projects/paper/versions/${version}/builds/${paperbuild}/downloads/paper-${version}-${paperbuild}.jar"
      ]
    },
    {
      "if": "modlauncher == 'paper'",
      "type": "move",
      "target": "server.jar",
      "source": "paper-*.jar"
    },
    {
      "if": "modlauncher == 'spigot'",
      "type": "download",
      "files": [
        "https://hub.spigotmc.org/jenkins/job/BuildTools/lastSuccessfulBuild/artifact/target/BuildTools.jar"
      ]
    },
    {
      "if": "modlauncher == 'spigot' && env == 'host'",
      "type": "command",
      "commands": [
        "java${javaversion} -jar BuildTools.jar --rev ${version}"
      ]
    },
    {
      "if": "modlauncher == 'spigot' && env != 'host'",
      "type": "command",
      "commands": [
        "java -jar BuildTools.jar --rev ${version}"
      ]
    },
    {
      "if": "modlauncher == 'spigot'",
      "type": "move",
      "source": "spigot-*.jar",
      "target": "server.jar"
    },
    {
      "if": "!file_exists(\"server.properties\")",
      "type": "writefile",
      "text": "server-ip=${ip}\nserver-port=${port}\nmotd=${motd}\n",
      "target": "server.properties"
    },
    {
      "type": "writefile",
      "text": "eula=${eula}",
      "target": "eula.txt"
    },
    {
      "type": "command",
      "commands": [
        "wget https://github.com/timvisee/lazymc/releases/download/v0.2.11/lazymc-v0.2.11-linux-x64 -o lazymc",
        "chmod a+x ./lazymc",
        "./lazymc config generate",
        "grep -zo '\\[config\\].*' lazymc.toml > lazymc.toml.bak"
      ]
    },
    {
      "type": "writefile",
      "text": "# lazymc configuration\n#\n# You must configure your server directory and start command, see:\n# - server.directory\n# - server.command\n#\n# All defaults are commented out, change it if you desire.\n# You can probably leave the rest as-is.\n#\n# You may generate a new configuration with: lazymc config generate\n# Or find the latest at: https://git.io/J1Fvq\n\n[public]\n# Public address. IP and port users connect to.\n# Shows sleeping status, starts server on connect, and proxies to server.\naddress = \"0.0.0.0:${port}\"\n\n# Server version & protocol hint.\n# Sent to clients until actual server version is known.\n# See: https://git.io/J1Fvx\n#version = \"1.20.3\"\n#protocol = 765\n\n[server]\n# Server address. Internal IP and port of server started by lazymc to proxy to.\n# Port must be different from public port.\naddress = \"127.0.0.1:{innerport}\"\n\n# Server directory, defaults to current directory.\ndirectory = \".\"\n\n# Command to start the server.\n# Warning: if using a bash script read: https://git.io/JMIKH\ncommand = \"{command}\"\n\n# Freeze the server process instead of restarting it when no players online, making it resume faster.\n# Only works on Unix (Linux or MacOS), ignored on Windows\n#freeze_process = true\n\n# Immediately wake server when starting lazymc.\n#wake_on_start = false\n\n# Immediately wake server after crash.\n#wake_on_crash = false\n\n# Probe required server details when starting lazymc, wakes server on start.\n# Improves client compatibility. Automatically enabled if required by other config properties.\n#probe_on_start = false\n\n# Set to true if this server runs Forge.\nforge = ${isforge}\n\n# Server start/stop timeout in seconds. Force kill server process if it takes too long.\n#start_timeout = 300\n#stop_timeout = 150\n\n# To wake server, user must be in server whitelist if enabled on server.\n#wake_whitelist = true\n\n# Block banned IPs as listed in banned-ips.json in server directory.\nblock_banned_ips = true\n\n# Drop connections from banned IPs.\n# Banned IPs won't be able to ping or request server status.\n# On connect, clients show a 'Disconnected' message rather than the ban reason.\ndrop_banned_ips = true\n\n[time]\n# Sleep after number of seconds.\nsleep_after = 60\n\n# Minimum time in seconds to stay online when server is started.\nminimum_online_time = 60\n\n[motd]\n# MOTD, shown in server browser.\nsleeping = \"☠ Server is sleeping\n§2☻ Join to start it up\"\nstarting = \"§2☻ Server is starting...\n§7⌛ Please wait...\"\nstopping = \"☠ Server going to sleep...\n⌛ Please wait...\"\n\n# Use MOTD from Minecraft server once known.\nfrom_server = true\n\n[join]\nmethods = [\n    \"hold\",\n#    \"kick\",\n]\n\n[join.kick]\n# Kick occupation method.\n# Instantly kicks a client with a message.\n\n# Message shown when client is kicked while server is starting/stopping.\n#starting = \"Server is starting... §c♥§r\n\nThis may take some time.\n\nPlease try to reconnect in a minute.\"\n#stopping = \"Server is going to sleep... §7☠§r\n\nPlease try to reconnect in a minute to wake it again.\"\n\n[join.hold]\n# Hold occupation method.\n# Holds back a joining client while the server is started until it is ready.\n# 'Connecting the server...' is shown on the client while it's held back.\n# If the server starts fast enough, the client won't notice it was sleeping at all.\n# This works for a limited time of 30 seconds, after which the Minecraft client times out.\n\n# Hold client for number of seconds on connect while server starts.\n# Keep below Minecraft timeout of 30 seconds.\ntimeout = 25\n\n[join.forward]\n\n\n[join.lobby]\n\n\n[lockout]\n#enabled = false\n#message = \"Server is closed §7☠§r\n\nPlease try to reconnect in a minute.\"\n\n[rcon]\n\n\n[advanced]\n\n\n",
      "target": "lazymc.toml"
    },
    {
      "type": "command",
      "commands": [
        "cat lazymc.toml.bak >> lazymc.toml",
        "rm lazymc.toml.bak",
        "sed -i \"s/{innerport}/$((${port}+30))/g\" lazymc.toml"
      ]
    }
  ],
  "run": {
    "command": [
      {
        "command": "./lazymc start"
      }
    ],
    "pre": [
      {
          "if": "modlauncher == 'forge'",
          "type": "resolveforgeversion",
          "minecraftVersion": "${version}",
          "version": "${forgebuild}",
          "outputVariable": "resolvedForgeVersion"
      },
      {
        "type": "command",
        "commands": "sed 's/command.?=.*/java${javaversion} -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar fabric-server-launch.jar nogui/g'",
        "if": "env == 'host' && file_exists('fabric-server-launch.jar')"
      },
      {
        "type": "command",
        "commands": "sed 's/java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar fabric-server-launch.jar nogui/g'",
        "if": "env != 'host' && file_exists('fabric-server-launch.jar')"
      },
      {
        "type": "command",
        "commands": "sed 's/java${javaversion} -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui/g'",
        "if": "env == 'host' && file_exists('server.jar')"
      },
      {
        "type": "command",
        "commands": "sed 's/java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui/g'",
        "if": "env != 'host' && file_exists('server.jar')"
      },
      {
        "type": "command",
        "commands": "sed 's/java${javaversion} -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/win_args.txt nogui/g'",
        "if": "env == 'host' && modlauncher == 'forge' && os == 'windows' && file_exists('libraries/net/minecraftforge/forge/' + resolvedForgeVersion + '/win_args.txt')"
      },
      {
        "type": "command",
        "commands": "sed 's/java${javaversion} -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/unix_args.txt nogui/g'",
        "if": "env == 'host' && modlauncher == 'forge' && file_exists('libraries/net/minecraftforge/forge/' + resolvedForgeVersion + '/unix_args.txt')"
      },
      {
        "type": "command",
        "commands": "sed 's/java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/win_args.txt nogui/g'",
        "if": "env != 'host' && modlauncher == 'forge' && os == 'windows' && file_exists('libraries/net/minecraftforge/forge/' + resolvedForgeVersion + '/win_args.txt')"
      },
      {
        "type": "command",
        "commands": "sed 's/java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} @libraries/net/minecraftforge/forge/${resolvedForgeVersion}/unix_args.txt nogui/g'",
        "if": "env != 'host' && modlauncher == 'forge' && file_exists('libraries/net/minecraftforge/forge/' + resolvedForgeVersion+ '/unix_args.txt')"
      },
      {
        "type": "command",
        "commands": "sed 's/java -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui/g'"
      }

    ],
    "stop": "stop",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "eclipse-temurin:${javaversion}",
      "portBindings": [
        "0.0.0.0:${port}:${port}/tcp"
      ]
    }
  ],
  "requirements": {},
  "stats": {
    "type": "jcmd"
  },
  "query": {
    "type": "minecraft"
  }
}
